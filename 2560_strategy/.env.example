# 2560 strategy production environment template
# Copy this file to .env and replace every placeholder before starting docker-compose.

APP_ENV=production
APP_DEBUG=0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-64-char-secret

# Initial admin bootstrap for an empty database.
# Do not use admin/admin123 in production.
ADMIN_INIT_USERNAME=replace-with-admin-username
ADMIN_INIT_PASSWORD=replace-with-strong-password-at-least-12-chars

MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password
MYSQL_DATABASE=strategy_2560
MYSQL_USER=strategy
MYSQL_PASSWORD=replace-with-strong-mysql-password

REDIS_PASSWORD=replace-with-strong-redis-password
CACHE_BACKEND=redis
TASK_QUEUE_BACKEND=redis
TASK_EXECUTION_MODE=worker
ALERT_EVALUATION_INTERVAL_SECONDS=300

MARKET_DATA_PROVIDER=mootdx
MARKET_DATA_FALLBACKS=akshare
MARKET_SYNC_INTERVAL_SECONDS=1800
MARKET_SYNC_SYMBOLS=all
MARKET_SYNC_INCREMENTAL=1
MARKET_BOOTSTRAP_ON_START=1
MARKET_BOOTSTRAP_DAYS=180
MARKET_SYNC_CORRECTION_DAYS=3
MARKET_SYNC_ADJUST=qfq
MARKET_SYNC_MAX_SYMBOLS=0
MARKET_SYNC_BATCH_SIZE=200
MARKET_SNAPSHOT_INTERVAL_SECONDS=60
MARKET_SNAPSHOT_SYMBOLS=all
MARKET_SNAPSHOT_MAX_SYMBOLS=0
MARKET_SNAPSHOT_BATCH_SIZE=500
STRATEGY_RUN_INTERVAL_SECONDS=300
STRATEGY_RUN_SCAN_LIMIT=6000
STRATEGY_RUN_MIN_COVERAGE_RATIO=0
PAPER_TRADING_ENABLED=1
PAPER_INITIAL_CASH=1000000
PAPER_CASH_PER_TRADE=50000
PAPER_MAX_POSITIONS=10
PAPER_STOP_LOSS_PCT=-0.08
PAPER_TAKE_PROFIT_PCT=0.15
PAPER_MAX_HOLDING_DAYS=20
PAPER_LOT_SIZE=100
PAPER_FEE_RATE=0
WORKER_TENANT_ID=1
# Keep 0 in production. Set to 1 only for local demos/tests that intentionally use mock data.
ALLOW_MOCK_MARKET_DATA=0

# Production data repositories must use MySQL during the SQLite retirement phase.
PICKS_REPOSITORY_BACKEND=mysql
AUTH_REPOSITORY_BACKEND=mysql
AUDIT_REPOSITORY_BACKEND=mysql
SETTINGS_REPOSITORY_BACKEND=mysql
LOGS_REPOSITORY_BACKEND=mysql
STRATEGY_POOL_REPOSITORY_BACKEND=mysql
STRATEGY_REPOSITORY_BACKEND=mysql
TRADING_REPOSITORY_BACKEND=mysql

# Optional image mirrors for restricted networks.
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
FRONTEND_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.27-alpine
PYTHON_BASE_IMAGE=python:3.11-slim

# Browser-visible value; do not put secrets here. In nginx production mode, same-origin /api/v1 is preferred.
# Production compose publishes only the frontend gateway port; MySQL, Redis, and backend stay on the internal Docker network.
# HTTPS is terminated by an external gateway/load balancer, which forwards HTTP to frontend:5174 and owns certificate renewal, HTTP->HTTPS redirect, and HSTS enforcement.
VITE_API_BASE=/api/v1

ACCESS_TOKEN_MINUTES=60
SESSION_COOKIE_SAMESITE=Lax

# Backend WSGI server tuning. Docker uses gunicorn instead of Flask dev server.
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT=120
WEB_GRACEFUL_TIMEOUT=30
